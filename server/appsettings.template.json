{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "REPLACE_WITH_USER_SECRETS_OR_ENVIRONMENT_VARIABLE"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_USER_SECRETS_OR_ENVIRONMENT_VARIABLE",
    "Issuer": "CollegeAPI",
    "Audience": "CollegeClient",
    "ExpirationInMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "RateLimiting": {
    "Enabled": null,
    "Rules": [
      { "Path": "/api/auth/login", "MaxRequests": 5, "WindowMinutes": 15 },
      { "Path": "/api/auth/register", "MaxRequests": 50, "WindowMinutes": 60 },
      { "Path": "/api/auth", "MaxRequests": 10, "WindowMinutes": 15 }
    ]
  }
}
