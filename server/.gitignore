## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/

# CRITICAL: Sensitive configuration files
appsettings.json
appsettings.Development.json
appsettings.Production.json
appsettings.*.json
!appsettings.template.json

# User Secrets
secrets.json

# Environment variables
.env
.env.local
.env.*.local

# Database files
*.db
*.db-shm
*.db-wal

# Logs
logs/
*.log

# Uploaded files
wwwroot/uploads/

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Node modules (if any)
node_modules/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
